{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoga-hannover",
  "main": "_worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
